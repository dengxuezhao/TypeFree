# GitHub 仓库与 Personal Access Token（需 Fine-grained PAT 仅授权 TypeFree 仓库 Issues: Read and write）
GITHUB_REPO=dengxuezhao/TypeFree
GITHUB_TOKEN=
# 官网地址（用于拼接国内直链下载 URL，留空则仅附 GitHub 链接）
OFFICIAL_SITE_ORIGIN=https://typefree.xuezhao.space

# QQ 官方开放平台机器人（Webhook v2 回调模式，推荐，长期在线不掉线）
QQ_OFFICIAL_APP_ID=
QQ_OFFICIAL_APP_SECRET=
QQ_OFFICIAL_API_BASE=https://api.sgroup.qq.com
QQ_OFFICIAL_VERIFY_SIG=true
# 可选：若未来开通群主动消息并拿到 group_openid，可填写以支持 GitHub 发布主动推送
QQ_OFFICIAL_GROUP_OPENID=

# 允许交互与推送的 QQ 群号（逗号分隔，仅 OneBot 模式使用）
QQ_GROUP_IDS=801143863
DEFAULT_QQ_GROUP_ID=801143863

# 首次扫码后填入小号 QQ，容器重启时自动快速登录（仅备用 OneBot 模式）
NAPCAT_QUICK_LOGIN_QQ=

# NapCat OneBot 11 HTTP 服务地址（纯 QQ 官方机器人模式下留空即可关闭 OneBot 调用）
ONEBOT_HTTP_URL=
ONEBOT_ACCESS_TOKEN=replace_with_onebot_access_token
# 若在 NapCat HTTP 上报客户端配置了 Secret，在此填同值用于 HMAC-SHA1 验签
ONEBOT_EVENT_SECRET=

# GitHub Actions 调 /github/notify 的 Bearer 鉴权密钥（务必设置为高强度随机串）
# 例如：openssl rand -hex 32
BRIDGE_SECRET=replace_with_random_hex_secret

# Bridge 监听地址与端口
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8090

# 防刷屏与防风控阈值
USER_COOLDOWN_SECONDS=15
GROUP_MAX_REPLIES_PER_MIN=10
MAX_ISSUES_PER_USER_PER_DAY=5
RELEASE_CACHE_TTL_SECONDS=60
# 默认不在公开 GitHub Issue 中暴露群友完整 QQ 号，仅记录群昵称与群号
INCLUDE_QQ_ID_IN_ISSUE=false
