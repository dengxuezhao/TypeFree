<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:settingsActivity="com.typefree.ime.MainActivity"
    android:supportsInlineSuggestions="true"
    android:supportsSwitchingToNextInputMethod="true"
    tools:targetApi="r">

    <subtype
        android:label="@string/ime_subtype_label_zh_cn"
        android:imeSubtypeLocale="zh_CN"
        android:imeSubtypeMode="keyboard"
        android:isAuxiliary="false" />

    <subtype
        android:label="@string/ime_subtype_label_zh_tw"
        android:imeSubtypeLocale="zh_TW"
        android:imeSubtypeMode="keyboard"
        android:isAuxiliary="false" />

    <subtype
        android:label="@string/ime_subtype_label_en_us"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:isAuxiliary="false" />

</input-method>
